# ─────────────────────────────────────────────────────────────
# FRONTEND (Vite) — only VITE_* vars are exposed to the browser.
# NEVER put secrets (API keys, private keys) here; they ship to every client.
# ─────────────────────────────────────────────────────────────

# Solana cluster the wallet/program connect to: devnet | testnet | mainnet-beta
VITE_SOLANA_CLUSTER=devnet

# Deployed golazo pack program ids, one per card edition (devnet). Leave both
# blank to run in FREE PLAY mode (packs open locally, no SOL needed).
VITE_PACK_PROGRAM_ID=GZUkNP4HhCdqZfZdQFhruArdz5oQ4Y8mgiS9wNPWc1ZL
VITE_PACK_PROGRAM_ID_2026=AY43PC3k3g1s8hBxZamVWubw35XDBBCHZBEg5ZeuLsJ2

# Optional custom RPC endpoint (overrides the cluster default).
VITE_SOLANA_RPC_URL=

# Golazo data service URL (TxODDS TxLINE proxy — see server/). Empty hides
# the LIVE match-center tab. For local dev: http://localhost:8787
VITE_DATA_API_URL=
