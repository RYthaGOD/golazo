# Golazo data service — server-side only. The TxLINE credentials are SECRETS
# (they come from a wallet-gated on-chain subscription); never expose them to
# the browser or commit a real .env.

PORT=8787

# Browser origin allowed to call this service (the deployed frontend).
CORS_ORIGIN=http://localhost:5173

# TxODDS TxLINE session (produced by the wallet subscribe+activate flow).
TXLINE_API_ORIGIN=https://txline-dev.txodds.com
TXLINE_JWT=
TXLINE_API_TOKEN=

# Fixture-id window to scan for covered matches (inclusive).
TXLINE_FIXTURE_RANGE=17588180-17588290
